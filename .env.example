# Copy this file to .env for local development.
# Never commit real credentials or replace this file with secret values.

APP_NAME=Personalized Memory Chat
DATABASE_PATH=memory.db
MEMORY_LIMIT=5
MEMORY_CANDIDATES=40
MAX_MESSAGE_CHARS=128000
PROMPT_MAX_CHARS=256000
LANGUAGE_HISTORY_LIMIT=3
# LANGUAGE_MODEL=chatgpt/gpt-6-luna (defaults to LLM_MODEL)
# EVAL_JUDGE_MODEL=chatgpt/gpt-6-astra (optional; eval runner also accepts --judge-model)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006/v1/traces

# OpenAI-compatible chat endpoint; use real values only in your private .env.
LLM_PROVIDER=openai-compatible
LLM_MODEL=chatgpt/gpt-6.1-sol
LLM_BASE_URL=
LLM_API_KEY=replace-with-local-secret
LLM_TIMEOUT_SECONDS=30
